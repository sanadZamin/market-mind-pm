
FROM node:20 AS builder
WORKDIR /app
RUN npm install -g pnpm

# Copy workspace config files
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc ./

# ✅ Fix 1: copy the root tsconfig that pm-tool extends
COPY tsconfig.base.json ./

COPY lib/ ./lib/
COPY artifacts/pm-tool/ ./artifacts/pm-tool/

RUN pnpm install --frozen-lockfile

# ✅ Fix 2: pass PORT and BASE_PATH — PORT can be any number (only used by dev
#    server, not the build output), BASE_PATH=/ for a standalone deployment
RUN PORT=3000 BASE_PATH=/ pnpm --filter @workspace/pm-tool run build

FROM nginx:alpine
COPY --from=builder /app/artifacts/pm-tool/dist/public /usr/share/nginx/html
EXPOSE 80
