# linux/amd64: workspace pnpm overrides drop Rollup/Tailwind native linux-arm64 optionals; arm64
# Docker builds would fail with "Cannot find @rollup/rollup-linux-arm64-gnu". Matches typical VPS.
FROM --platform=linux/amd64 node:20 AS builder
WORKDIR /app
RUN npm install -g pnpm

# Copy workspace config files
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc ./

# Fix 1: copy the root tsconfig that pm-tool extends
COPY tsconfig.base.json ./

COPY lib/ ./lib/
COPY artifacts/pm-tool/ ./artifacts/pm-tool/

RUN pnpm install --frozen-lockfile

# Sign-in URL path segment baked at build time (no leading slash), e.g. mm-workbench -> /pm/mm-workbench
ARG VITE_PM_SIGNIN_PATH=login
ARG BASE_PATH=/pm
ARG VITE_MARKETING_MAINTENANCE=true

# PORT is only used by the dev server, not the build output
RUN PORT=3000 BASE_PATH=${BASE_PATH} VITE_PM_SIGNIN_PATH=${VITE_PM_SIGNIN_PATH} VITE_MARKETING_MAINTENANCE=${VITE_MARKETING_MAINTENANCE} pnpm --filter @workspace/pm-tool run build

FROM --platform=linux/amd64 nginx:alpine
COPY --from=builder /app/artifacts/pm-tool/dist/public /usr/share/nginx/html
# Proxy /api/* to the API container and serve SPA fallback for all other routes
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
