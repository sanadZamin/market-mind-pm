FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /app

COPY artifacts/api-server-springboot/pom.xml ./pom.xml
COPY artifacts/api-server-springboot/src ./src

RUN mvn -q -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/target/*.jar /app/app.jar

ENV PORT=8081
EXPOSE 8081

HEALTHCHECK --interval=5s --timeout=3s --start-period=90s --retries=12 \
  CMD curl -sf http://127.0.0.1:8081/api/actuator/health/liveness >/dev/null || exit 1

ENTRYPOINT ["java","-jar","/app/app.jar"]

